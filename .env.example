# Seed script: Admin credentials
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123"

# Required: Authentication secrets (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Required: Email service
RESEND_API_KEY=
TARGET_EMAIL=

# Optional: Contact information
TARGET_PHONE=

# Optional / Required for admin: Database (Prisma Postgres)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key="
# Optional: Database (Prisma Postgres - Direct)
DIRECT_DATABASE_URL="postgres://"

# Optional: Allowed origins for CORS (comma-separated, e.g., https://example.com,https://www.example.com)
ALLOWED_ORIGINS=
